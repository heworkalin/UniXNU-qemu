# Kernel configuration of the QEMU virt image, kept the same as pipa_defconfig of UniXNU-pipa: the generic CPU,
# interrupt, timer and platform expert path, the source corecrypto and pthread providers and NativeAES, enough to reach
# the root mount. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build. ArmDTPlatform, not ArmVirtPlatform, takes
# the root, as on the tablets.
#
# Left out until their inputs exist: NATIVE_UFS (SM8550 registers), the owner root chain
# (VERIFIED_ROOT_PROBE, OWNER_*; it needs owner-signed volume policies, see qemu_root_defconfig), BOOT_PROGRESS (it requires that chain),
# NATIVE_LEGACY_DISPLAY (its archive carries the sheng board probes), NATIVE_RAM_BLOCK (no Data yet) and
# NATIVE_ADRENO. SHENG_PMGR links the original-PMGR bridge (scripts/build-platform-power.py), without which the
# original AMFI panics with "No PMGR". XNU's video console draws nothing here despite -v: after the entry probe bars,
# the panic screen is the only kernel output on the frame buffer.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_SHENG_PMGR=n
# PMGR shim 的存在意义是替 AMFI 提供 readAon/writeAon 的 ABI（并配有 AMFI→PMGR 契约审计）。
# 本阶段 AMFI 已被 miniamfi 替掉（临时，见 docx/QEMU_LOOP §14），所以一并关掉；
# 恢复 AMFI 时这里也要恢复成 y。
# XNU's mockfs as a root on md0 (rd=md0): run-qemu.py --native-user boots UniXNU's static test process from it.
# mockfs：两个用途
#  1) 上游 --native-user 的测试根；
#  2) picasso 线复现 M6" 的**第一个根**（ramdisk 根等价物），再用
#     picasso_switch_root=<分区> 触发第二次 vfs_mountroot() 切到我们的卷。
# 不用它当根时（例如只用 ufs_root 直接挂我们的卷），把它设成 n 更省事。
CONFIG_XNU_SOURCE_MOCKFS=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# No-op hooks for probes of the left-out components (scripts/build-link-stubs.py).
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
# virtio-blk 必须走专用开关：EXTRA_LD_ARCHIVES 是不带 -force_load 的裸归档路径，
# 无人引用其符号时会被链接器整个丢弃（内核里 0 个 virtio 符号，磁盘探测静默失效）。
# 关掉上游的 IOBlockStorageDevice 路线：它要 IOStorageFamily 的内核链接期符号（预链接 kext），
# 需要整套 storage-ABI 资格认证；我们改用自己的 bdevsw 栈（bsd/dev/picasso_ufs.c + picasso_virtblk.c）。
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Archives of [kernel] in board.toml are built from the compile records (tool tree 066c8d8 needs this on).
CONFIG_XNU_BUILD_ARCHIVES=y

# Serial console: XNU's pexpert/arm/pe_serial.c has the PL011 path behind VMAPPLE_UART, which
# looks for a DT node named "uart0"; scripts/qemu-entry/make-dt.py declares it with --qemu-uart.
# With this and "serial=3" the kernel log goes to the QEMU serial port (terminal), not only to
# the frame buffer.
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -DVMAPPLE_UART=1"

# S3/S4：链接我们的 Legacy ABI 虚表（钩子会打 PICASSO-LEGACY 日志）
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
